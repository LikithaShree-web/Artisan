# Local-only staging database. This must remain separate from backend/.env.
MONGO_URL=mongodb://127.0.0.1:27017/artisan_marketplace_staging
# Generate a new staging-only value; do not copy JWT_SECRET_PASSWORD from backend/.env.
JWT_SECRET_PASSWORD=replace-with-a-unique-random-secret-at-least-32-characters
PORT=5001
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
