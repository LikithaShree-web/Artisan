MONGO_URL=mongodb://127.0.0.1:27017/artisan_marketplace
JWT_SECRET_PASSWORD=replace-with-a-random-secret-of-at-least-32-characters
PORT=5000
# Optional one-time bootstrap for a new database. Set both; password must be at least 12 characters.
# Remove ADMIN_PASSWORD after the first successful bootstrap.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
